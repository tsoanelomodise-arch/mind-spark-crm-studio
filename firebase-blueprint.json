{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "AI prompt template in the library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "updated_at": { "type": "string" },
        "user_id": { "type": "string" },
        "client_id": { "type": "string" }
      }
    },
    "Client": {
      "title": "Client",
      "description": "Client account profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "industry": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "description": "Client project or pipeline item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "client_id": { "type": "string" },
        "status": { "type": "string" },
        "impl_stage": { "type": "string" },
        "stage": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "due_date": { "type": "string" },
        "notes": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "Credential": {
      "title": "Credential",
      "description": "Stored system login and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "label": { "type": "string" },
        "system": { "type": "string" },
        "url": { "type": "string" },
        "username": { "type": "string" },
        "notes": { "type": "string" },
        "last_rotated_at": { "type": "string" }
      }
    },
    "ProjectTask": {
      "title": "ProjectTask",
      "description": "Milestones and tasks within a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "project_id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "due_date": { "type": "string" }
      }
    },
    "ClientNote": {
      "title": "ClientNote",
      "description": "Notes associated with a client or project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "project_id": { "type": "string" },
        "body": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" }
      }
    },
    "ClientConversation": {
      "title": "ClientConversation",
      "description": "Client interaction thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "Contact": {
      "title": "Contact",
      "description": "Client contact person",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "WikiSpace": {
      "title": "WikiSpace",
      "description": "Wiki space container",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "WikiPage": {
      "title": "WikiPage",
      "description": "Wiki article page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "space_id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "AppState": {
      "title": "AppState",
      "description": "Global state sync document for mind spark studio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "payload": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/Prompt" },
      "description": "Library of AI prompt templates"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Client account records"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Client projects"
    },
    "/credentials/{credentialId}": {
      "schema": { "$ref": "#/entities/Credential" },
      "description": "Encrypted system credentials"
    },
    "/project_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/ProjectTask" },
      "description": "Project tasks"
    },
    "/client_notes/{noteId}": {
      "schema": { "$ref": "#/entities/ClientNote" },
      "description": "Client meeting notes"
    },
    "/client_conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ClientConversation" },
      "description": "Client conversations"
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Client contacts"
    },
    "/wiki_spaces/{spaceId}": {
      "schema": { "$ref": "#/entities/WikiSpace" },
      "description": "Wiki spaces"
    },
    "/wiki_pages/{pageId}": {
      "schema": { "$ref": "#/entities/WikiPage" },
      "description": "Wiki pages"
    },
    "/app_state/{docId}": {
      "schema": { "$ref": "#/entities/AppState" },
      "description": "Synchronized app state store"
    }
  }
}
